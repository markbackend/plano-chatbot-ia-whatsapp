# Copiá este archivo como .env y completalo. Nunca subas el .env a git.

# ---------- WhatsApp (developers.facebook.com > tu app > WhatsApp > Configuración de la API) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que inventás vos y ponés también en la configuración del webhook de Meta
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app > Básica > Clave secreta de la app (valida que los avisos vienen de Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Número del dueño (con código de país, sin +). Recibe los avisos de derivación y puede mandar comandos:
# #reactivar <tel>, #pausar <tel> [horas], #pausados
DUENO_TELEFONO=

# ---------- IA ----------
# anthropic | openai | falso (falso = sin clave, para probar)
PROVEEDOR_IA=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5
ANTHROPIC_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4.1-mini
# Sirve para cualquier API compatible con OpenAI (OpenRouter, un servidor local, etc.)
OPENAI_URL=https://api.openai.com
# Tope de tokens de cada respuesta (mantiene las respuestas cortas)
MAX_TOKENS_RESPUESTA=300
# Tope de tokens por día para todo el bot (entrada + salida). Al llegar, responde el mensaje de respaldo. 0 = sin tope
TOPE_TOKENS_DIA=200000
# Segundos máximos de espera a la IA
TIMEOUT_IA=25

# ---------- Negocio y conversación ----------
# Archivo con productos, precios, horarios y políticas. La IA solo usa lo que está ahí.
NEGOCIO=negocio.md
BASE_DATOS=datos/conversaciones.db
# Cuántos mensajes anteriores del chat ve la IA
HISTORIAL_MENSAJES=10
# Máximo de mensajes por cliente por hora (anti abuso / anti gasto). 0 = sin límite
MAX_MENSAJES_HORA=20
# Horas que el bot queda callado en un chat derivado a una persona
HORAS_PAUSA=12
ZONA_HORARIA=America/Argentina/Buenos_Aires
# Horario de atención humana (para decirle al cliente cuándo le responden)
HORARIO=09:00-18:00
# 0 = lunes ... 6 = domingo
DIAS_HABILES=0-4

# ---------- Panel ----------
# Clave del panel /admin/conversaciones (usuario: cualquiera). Vacía = panel deshabilitado
ADMIN_CLAVE=
# 1 = habilita POST /demo/chat para probar sin WhatsApp. NO dejar en 1 en producción
MODO_DEMO=0
